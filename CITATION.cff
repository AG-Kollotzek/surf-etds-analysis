cff-version: 1.2.0
title: "SURF ETD analysis pipeline"
message: "If you use this software, please cite it as below, and cite the data with the citation of surf-etds-data."
type: software
authors:
  - given-names: Tim
    family-names: Buck
    affiliation: "Department of Radiation Oncology, Medical University of Innsbruck"
  - given-names: N.
    family-names: Bersenkowitsch
    affiliation: "Department of Radiation Oncology, Tirol Kliniken"
